#!/usr/bin/env bash
# VM Windows di Borsini (BORSINISERVER, EpyX) in Remmina, password dal vault (voce "rdp borsini").
# Super+B (menu.lua). Usa il profilo salvato in Remmina; la copia con la password (cifrata col
# segreto di remmina.pref) sta in RAM e sparisce allo spegnimento.
set -euo pipefail

profile=~/.local/share/remmina/group_rdp_borsiniserver_192-168-1-203.remmina
run="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/borsini.remmina"

enc=$(rbw get "rdp borsini" | remmina --encrypt-password 2>/dev/null | sed -n 's/^Encrypted password: //p') || true
[[ -n $enc ]] || { notify-send "Borsini" "Vault bloccato o voce \"rdp borsini\" mancante"; exit 1; }

# Niente conferma alla chiusura. remmina.pref resta fuori dai dotfiles: contiene il segreto delle password
pref=~/.config/remmina/remmina.pref
[[ -f $pref ]] && sed -i 's/^confirm_close=true$/confirm_close=false/' "$pref"

umask 077
# disablepasswordstoring: altrimenti al salvataggio del profilo Remmina copia la password nel
# portachiavi GNOME, che col login automatico è bloccato e chiede la sua password
# viewmode=1 e niente maximize: finestra normale, gestita da Hyprland (il profilo è a schermo intero)
sed -e "s|^password=.*|password=$enc|" -e "s|^disablepasswordstoring=.*|disablepasswordstoring=1|" \
    -e "s|^viewmode=.*|viewmode=1|" -e "s|^window_maximize=.*|window_maximize=0|" \
    "$profile" >"$run"
exec remmina -c "$run"
