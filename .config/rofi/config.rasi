/* rofi: per ora solo rofi-rbw (Super+P, Bitwarden). fuzzel 1.14 non ha più --override,
   che rofi-rbw usa per le scorciatoie Alt+…: con rofi funzionano tutte.
   Tema come i widget (hypr/widgets/shared/Theme.qml): nero, testo quasi bianco, angoli vivi,
   cornice ciano 2 px perché prende la tastiera, corrispondenze in verde. */
@theme "/dev/null"   /* senza il tema predefinito, che colora le righe alterne di crema */

configuration {
    font: "GeistMono Nerd Font 13";
    show-icons: false;
}

* {
    bg:      #000000;
    raised:  #18181b;
    fg:      #f4f4f5;
    dim:     #a0a0a6;
    accent:  #33ccff;
    accent2: #00ff99;
    background-color: transparent;
    text-color: @fg;
}

window {
    width: 50%;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 0;
    padding: 12px;
}
mainbox  { spacing: 10px; children: [ inputbar, message, listview ]; }
inputbar { spacing: 8px; children: [ prompt, entry ]; }
prompt   { text-color: @accent; }
entry    { placeholder: "cerca"; placeholder-color: @dim; }
textbox  { text-color: @dim; }
listview { lines: 12; scrollbar: false; spacing: 2px; }
element  { padding: 2px 6px; }
element selected.normal { background-color: @raised; text-color: @accent; }
element-text { text-color: inherit; highlight: bold #00ff99; }
